{
  "name": "4e-next-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D&D 4E 中文数据核心：一个可直接接入的 SQLite 数据库 + 类型化查询接口",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./src/api/index.ts",
  "exports": {
    ".": "./src/api/index.ts",
    "./schema": "./src/schema/db.ts",
    "./sql": "./src/db/schema.sql"
  },
  "scripts": {
    "sync": "node src/cli.ts sync",
    "rebuild": "node src/cli.ts all",
    "db": "node src/cli.ts db",
    "verify": "node src/cli.ts verify",
    "profile": "node src/cli.ts profile",
    "status": "node src/cli.ts status",
    "query": "node src/cli.ts query",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
